---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const formattedDate = post.data.pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = post.data.pubDate.toISOString();
const pageURL = new URL(`/posts/${post.slug}/`, Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: isoDate,
  dateModified: isoDate,
  mainEntityOfPage: pageURL,
  publisher: {
    "@type": "Organization",
    name: "우리집 가전 사이즈",
  },
};
---
<Layout title={post.data.title} description={post.data.description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <p class="article-meta">{post.data.category} · {formattedDate}</p>
    <h1>{post.data.title}</h1>
    <Content />
    <p class="disclaimer">이 글은 정보 제공을 목적으로 하며, 본문의 수치는 각 문단에 표기된 출처 기준입니다. 현재 이 사이트는 광고 계약이 없으며, 향후 제휴가 체결되면 해당 콘텐츠에 명확히 표시합니다.</p>
  </article>
</Layout>
