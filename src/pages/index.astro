---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const appliances = (await getCollection('appliances')).sort(
  (a, b) => a.data.capacityLiters - b.data.capacityLiters
);

const slugify = (brand: string, model: string) =>
  `${brand}-${model}`.toLowerCase().replace(/[^\w가-힣]+/g, '-').replace(/^-+|-+$/g, '');

const asOfDate = appliances[0]?.data.source.asOfDate ?? '';
const minCapacity = appliances[0]?.data.capacityLiters ?? 0;
const maxCapacity = appliances[appliances.length - 1]?.data.capacityLiters ?? 0;
---
<Layout title="우리집 가전 사이즈 — 폭·깊이·높이 입력하면 맞는 미니냉장고만 골라드립니다" description="온라인으로 냉장고를 샀는데 자리에 안 들어가는 실패를 막기 위해, 우리집 공간 치수를 입력하면 실제로 들어가는 미니냉장고 모델만 자동으로 필터링해 보여주는 규격 매칭 도구입니다.">
  <section class="hero">
    <p class="hero-eyebrow">치수만 알면 5초, 반품 걱정 없이</p>
    <h1>이 자리에 들어가는 냉장고, 치수로 바로 찾아드립니다</h1>
    <p class="hero-sub">"원룸 추천템" 리스트는 많지만, 정작 우리집 그 자리에 들어가는지는 직접 재보고 하나하나 대조해야 했습니다. 냉장고 놓을 자리의 폭·깊이·높이를 입력하면, 제조사 공식 규격 기준으로 실제로 들어가는 모델만 걸러서 보여드립니다.</p>
  </section>

  <section class="fit-form" id="fit-form">
    <h2 style="margin-top:0;border-top:none;padding-top:0;">우리집 자리 치수 입력</h2>
    <p class="fit-hint">가전을 놓을 자리의 <strong>최대 허용 치수</strong>(벽·가구 사이 여유 공간)를 cm 단위로 입력하세요. 아는 값만 입력해도 됩니다.</p>
    <div class="fit-form-grid">
      <div class="fit-field">
        <label for="input-width">폭 (cm)</label>
        <input type="number" id="input-width" inputmode="decimal" min="0" placeholder="예: 50" />
      </div>
      <div class="fit-field">
        <label for="input-depth">깊이 (cm)</label>
        <input type="number" id="input-depth" inputmode="decimal" min="0" placeholder="예: 55" />
      </div>
      <div class="fit-field">
        <label for="input-height">높이 (cm)</label>
        <input type="number" id="input-height" inputmode="decimal" min="0" placeholder="예: 120" />
      </div>
    </div>
    <p class="fit-hint">※ 위 수치는 벽·가구와 부딪히지 않는 "최대 허용 치수"만 걸러줍니다. 방열을 위한 여유 공간(보통 상단·후면 5~10cm)은 별도로 고려해야 하며, 정확한 여유 공간은 각 모델 상세페이지·사용설명서를 확인하세요.</p>
    <button type="button" class="fit-reset" id="fit-reset">입력 초기화</button>
    <p class="fit-status" id="fit-status" role="status"></p>
  </section>

  <section class="category-group">
    <h2>미니냉장고 규격 비교 ({minCapacity}L~{maxCapacity}L, {appliances.length}개 모델)</h2>
    <p class="category-hook">위 칸에 치수를 입력하면 아래 표가 자동으로 필터링됩니다. 표에는 항상 전체 모델을 볼 수 있도록 초기화 버튼을 제공합니다.</p>

    <div class="table-scroll">
      <table id="fit-table">
        <thead>
          <tr>
            <th>브랜드 / 모델</th>
            <th>용량</th>
            <th>도어</th>
            <th>폭</th>
            <th>깊이</th>
            <th>높이</th>
            <th>출처</th>
          </tr>
        </thead>
        <tbody>
          {appliances.map((item) => (
            <tr
              data-width={item.data.dimensions.widthMm}
              data-depth={item.data.dimensions.depthMm}
              data-height={item.data.dimensions.heightMm}
            >
              <td><a href={`/appliances/${slugify(item.data.brand, item.data.model)}/`}>{item.data.brand} {item.data.model}</a></td>
              <td>{item.data.capacityLiters}L</td>
              <td>{item.data.doorType}</td>
              <td>{item.data.dimensions.widthMm}mm</td>
              <td>{item.data.dimensions.depthMm}mm</td>
              <td>{item.data.dimensions.heightMm}mm</td>
              <td><a href={item.data.source.url} target="_blank" rel="noopener" class="cell-note">{item.data.source.name}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="disclaimer">
      규격은 각 제품의 공식/스펙 페이지를 그대로 옮긴 것이며(조회일 {asOfDate}), 모델 단종·사양 변경 시 최신 정보와 다를 수 있습니다. 구매 전 반드시 표의 출처 링크에서 최신 스펙을 다시 확인하세요. 오류를 발견하셨다면 <a href="mailto:keiji960+mj06@gmail.com">keiji960+mj06@gmail.com</a>으로 알려주세요.
    </p>
  </section>

  {posts.length > 0 && (
    <section class="category-group">
      <h2>가이드</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-card" href={`/posts/${post.slug}/`}>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>

<script>
  const widthInput = document.getElementById('input-width') as HTMLInputElement;
  const depthInput = document.getElementById('input-depth') as HTMLInputElement;
  const heightInput = document.getElementById('input-height') as HTMLInputElement;
  const resetBtn = document.getElementById('fit-reset') as HTMLButtonElement;
  const status = document.getElementById('fit-status') as HTMLParagraphElement;
  const rows = Array.from(document.querySelectorAll('#fit-table tbody tr')) as HTMLTableRowElement[];

  function cmToMm(value: string): number | null {
    if (value.trim() === '') return null;
    const n = Number(value);
    if (Number.isNaN(n) || n <= 0) return null;
    return n * 10;
  }

  function applyFilter() {
    const maxWidth = cmToMm(widthInput.value);
    const maxDepth = cmToMm(depthInput.value);
    const maxHeight = cmToMm(heightInput.value);
    const anyInput = maxWidth !== null || maxDepth !== null || maxHeight !== null;

    let matchCount = 0;

    rows.forEach((row) => {
      const w = Number(row.dataset.width);
      const d = Number(row.dataset.depth);
      const h = Number(row.dataset.height);

      const fitsWidth = maxWidth === null || w <= maxWidth;
      const fitsDepth = maxDepth === null || d <= maxDepth;
      const fitsHeight = maxHeight === null || h <= maxHeight;
      const fits = fitsWidth && fitsDepth && fitsHeight;

      row.classList.toggle('row-hidden', anyInput && !fits);
      row.classList.toggle('row-fit', anyInput && fits);
      if (anyInput && fits) matchCount += 1;
    });

    if (!anyInput) {
      status.textContent = '';
    } else if (matchCount === 0) {
      status.textContent = '입력한 치수에 맞는 모델이 없습니다. 다른 치수를 시도하거나 전체 표를 참고하세요.';
    } else {
      status.textContent = `입력한 자리에 들어가는 모델 ${matchCount}개를 찾았습니다.`;
    }
  }

  [widthInput, depthInput, heightInput].forEach((el) => el.addEventListener('input', applyFilter));
  resetBtn.addEventListener('click', () => {
    widthInput.value = '';
    depthInput.value = '';
    heightInput.value = '';
    applyFilter();
  });
</script>
