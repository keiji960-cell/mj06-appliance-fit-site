---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const appliances = (await getCollection('appliances')).sort((a, b) => {
  if (a.data.category !== b.data.category) return a.data.category.localeCompare(b.data.category, 'ko-KR');
  return a.data.dimensions.widthMm - b.data.dimensions.widthMm;
});

const slugify = (category: string, brand: string, model: string) =>
  `${category}-${brand}-${model}`.toLowerCase().replace(/[^\w가-힣]+/g, '-').replace(/^-+|-+$/g, '');

const asOfDate = appliances.reduce(
  (latest, item) => (item.data.source.asOfDate > latest ? item.data.source.asOfDate : latest),
  appliances[0]?.data.source.asOfDate ?? ''
);

const categories = [...new Set(appliances.map((item) => item.data.category))];
const categoryCounts = categories.map((cat) => ({
  name: cat,
  count: appliances.filter((item) => item.data.category === cat).length,
}));
---
<Layout title="우리집 가전 사이즈 — 폭·깊이·높이 입력하면 맞는 가전만 골라드립니다" description="온라인으로 가전을 샀는데 자리에 안 들어가는 실패를 막기 위해, 우리집 공간 치수를 입력하면 실제로 들어가는 미니냉장고·소형세탁기·창문형에어컨·제습기 모델만 자동으로 필터링해 보여주는 규격 매칭 도구입니다.">
  <section class="hero">
    <p class="hero-eyebrow">치수만 알면 5초, 반품 걱정 없이</p>
    <h1>이 자리에 들어가는 가전, 치수로 바로 찾아드립니다</h1>
    <p class="hero-sub">"원룸 추천템" 리스트는 많지만, 정작 우리집 그 자리에 들어가는지는 직접 재보고 하나하나 대조해야 했습니다. 가전을 놓을 자리의 폭·깊이·높이를 입력하면, 제조사 공식 규격 기준으로 실제로 들어가는 모델만 걸러서 보여드립니다.</p>
    <ul class="hero-facts">
      {categoryCounts.map((c) => (
        <li>{c.name} {c.count}개</li>
      ))}
    </ul>
  </section>

  <section class="fit-form" id="fit-form">
    <h2 style="margin-top:0;border-top:none;padding-top:0;">우리집 자리 치수 입력</h2>
    <p class="fit-hint">가전을 놓을 자리의 <strong>최대 허용 치수</strong>(벽·가구 사이 여유 공간)를 mm 단위로 입력하세요. 아래 표의 규격과 같은 단위라 그대로 비교할 수 있습니다. 아는 값만 입력해도 됩니다.</p>
    <div class="fit-field" style="max-width:260px;margin-bottom:1rem;">
      <label for="input-category">카테고리</label>
      <select id="input-category">
        <option value="">전체 카테고리</option>
        {categories.map((cat) => (
          <option value={cat}>{cat}</option>
        ))}
      </select>
    </div>
    <div class="fit-form-grid">
      <div class="fit-field">
        <label for="input-width">폭 (mm)</label>
        <input type="number" id="input-width" inputmode="decimal" min="0" step="1" placeholder="예: 500" />
      </div>
      <div class="fit-field">
        <label for="input-depth">깊이 (mm)</label>
        <input type="number" id="input-depth" inputmode="decimal" min="0" step="1" placeholder="예: 550" />
      </div>
      <div class="fit-field">
        <label for="input-height">높이 (mm)</label>
        <input type="number" id="input-height" inputmode="decimal" min="0" step="1" placeholder="예: 1200" />
      </div>
    </div>
    <p class="fit-hint">※ 위 수치는 벽·가구와 부딪히지 않는 "최대 허용 치수"만 걸러줍니다. 방열/환기를 위한 여유 공간(보통 상단·후면·측면 50~100mm)은 별도로 고려해야 하며, 정확한 여유 공간은 각 모델 상세페이지·사용설명서를 확인하세요.</p>
    <button type="button" class="fit-reset" id="fit-reset">입력 초기화</button>
    <p class="fit-status" id="fit-status" role="status"></p>
  </section>

  <section class="category-group">
    <h2>가전 규격 비교 ({categories.length}개 카테고리, {appliances.length}개 모델)</h2>
    <p class="category-hook">위 칸에 카테고리·치수를 입력하면 아래 표가 자동으로 필터링됩니다. 표에는 항상 전체 모델을 볼 수 있도록 초기화 버튼을 제공합니다.</p>

    <div class="table-scroll">
      <table id="fit-table">
        <thead>
          <tr>
            <th>카테고리</th>
            <th>브랜드 / 모델</th>
            <th>용량</th>
            <th>유형</th>
            <th>폭</th>
            <th>깊이</th>
            <th>높이</th>
            <th>출처</th>
          </tr>
        </thead>
        <tbody>
          {appliances.map((item) => (
            <tr
              data-category={item.data.category}
              data-width={item.data.dimensions.widthMm}
              data-depth={item.data.dimensions.depthMm}
              data-height={item.data.dimensions.heightMm}
            >
              <td>{item.data.category}</td>
              <td><a href={`/appliances/${slugify(item.data.category, item.data.brand, item.data.model)}/`}>{item.data.brand} {item.data.model}</a></td>
              <td>{item.data.capacityValue}{item.data.capacityUnit}</td>
              <td>{item.data.typeLabel}</td>
              <td>{item.data.dimensions.widthMm}mm</td>
              <td>{item.data.dimensions.depthMm}mm</td>
              <td>{item.data.dimensions.heightMm}mm</td>
              <td><a href={item.data.source.url} target="_blank" rel="noopener" class="cell-note">{item.data.source.name}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="disclaimer">
      규격은 각 제품의 공식/스펙 페이지를 그대로 옮긴 것이며(가장 최근 확인일 {asOfDate}), 모델 단종·사양 변경 시 최신 정보와 다를 수 있습니다. 구매 전 반드시 표의 출처 링크에서 최신 스펙을 다시 확인하세요. 오류를 발견하셨다면 <a href="mailto:keiji960+mj06@gmail.com">keiji960+mj06@gmail.com</a>으로 알려주세요.
    </p>
  </section>

  {posts.length > 0 && (
    <section class="category-group">
      <h2>가이드</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-card" href={`/posts/${post.slug}/`}>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>

<script>
  const categorySelect = document.getElementById('input-category') as HTMLSelectElement;
  const widthInput = document.getElementById('input-width') as HTMLInputElement;
  const depthInput = document.getElementById('input-depth') as HTMLInputElement;
  const heightInput = document.getElementById('input-height') as HTMLInputElement;
  const resetBtn = document.getElementById('fit-reset') as HTMLButtonElement;
  const status = document.getElementById('fit-status') as HTMLParagraphElement;
  const rows = Array.from(document.querySelectorAll('#fit-table tbody tr')) as HTMLTableRowElement[];

  function parseMm(value: string): number | null {
    if (value.trim() === '') return null;
    const n = Number(value);
    if (Number.isNaN(n) || n <= 0) return null;
    return n;
  }

  function applyFilter() {
    const category = categorySelect.value;
    const maxWidth = parseMm(widthInput.value);
    const maxDepth = parseMm(depthInput.value);
    const maxHeight = parseMm(heightInput.value);
    const anyInput = category !== '' || maxWidth !== null || maxDepth !== null || maxHeight !== null;

    let matchCount = 0;

    rows.forEach((row) => {
      const w = Number(row.dataset.width);
      const d = Number(row.dataset.depth);
      const h = Number(row.dataset.height);

      const matchesCategory = category === '' || row.dataset.category === category;
      const fitsWidth = maxWidth === null || w <= maxWidth;
      const fitsDepth = maxDepth === null || d <= maxDepth;
      const fitsHeight = maxHeight === null || h <= maxHeight;
      const fits = matchesCategory && fitsWidth && fitsDepth && fitsHeight;

      row.classList.toggle('row-hidden', anyInput && !fits);
      row.classList.toggle('row-fit', anyInput && fits);
      if (anyInput && fits) matchCount += 1;
    });

    if (!anyInput) {
      status.textContent = '';
    } else if (matchCount === 0) {
      status.textContent = '조건에 맞는 모델이 없습니다. 카테고리나 치수를 다시 시도하거나 전체 표를 참고하세요.';
    } else {
      status.textContent = `조건에 맞는 모델 ${matchCount}개를 찾았습니다.`;
    }
  }

  [categorySelect, widthInput, depthInput, heightInput].forEach((el) =>
    el.addEventListener('input', applyFilter)
  );
  categorySelect.addEventListener('change', applyFilter);
  resetBtn.addEventListener('click', () => {
    categorySelect.value = '';
    widthInput.value = '';
    depthInput.value = '';
    heightInput.value = '';
    applyFilter();
  });
</script>
