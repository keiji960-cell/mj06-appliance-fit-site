---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const slugify = (category: string, brand: string, model: string) =>
    `${category}-${brand}-${model}`.toLowerCase().replace(/[^\w가-힣]+/g, '-').replace(/^-+|-+$/g, '');
  const appliances = await getCollection('appliances');
  return appliances.map((item) => ({
    params: { slug: slugify(item.data.category, item.data.brand, item.data.model) },
    props: { item },
  }));
}

interface Props {
  item: CollectionEntry<'appliances'>;
}

const { item } = Astro.props;
const { data } = item;

// 카테고리별 실제 발급받은 쿠팡파트너스 링크만 여기 등록한다 — 없는 카테고리는 CTA를 아예 노출하지 않는다
// (다른 카테고리 검색 결과로 연결하면 애드센스/쿠팡 정책이 금지하는 "오해 소지 있는 링크"가 됨).
const coupangLinksByCategory: Record<string, string> = {
  미니냉장고: 'https://link.coupang.com/a/fFeF4Sgx7k',
};
const coupangUrl = coupangLinksByCategory[data.category];
---
<Layout
  title={`${data.brand} ${data.model} 규격 — ${data.dimensions.widthMm}×${data.dimensions.depthMm}×${data.dimensions.heightMm}mm`}
  description={`${data.brand} ${data.model} (${data.capacityValue}${data.capacityUnit})의 정확한 가로×깊이×높이 규격과 설치 여백 안내입니다.`}
  type="article"
>
  <article>
    <p class="article-meta">{data.category} · 조회일 {data.source.asOfDate}</p>
    <h1>{data.brand} {data.model}</h1>
    {coupangUrl && (
      <p class="disclaimer" style="margin-top:0;">이 페이지는 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받을 수 있습니다.</p>
    )}
    <p>{data.capacityValue}{data.capacityUnit} · {data.typeLabel}</p>

    <div class="table-scroll">
      <table>
        <tbody>
          <tr><th>폭 (Width)</th><td>{data.dimensions.widthMm}mm</td></tr>
          <tr><th>깊이 (Depth)</th><td>{data.dimensions.depthMm}mm</td></tr>
          <tr><th>높이 (Height)</th><td>{data.dimensions.heightMm}mm</td></tr>
          <tr><th>용량</th><td>{data.capacityValue}{data.capacityUnit}</td></tr>
          <tr><th>유형</th><td>{data.typeLabel}</td></tr>
        </tbody>
      </table>
    </div>

    <div class="callout">
      <p><strong>설치 여백 안내:</strong> {data.installClearanceNote}</p>
    </div>

    {coupangUrl && (
      <div class="coupang-cta">
        <a href={coupangUrl} target="_blank" rel="noopener nofollow sponsored">쿠팡에서 {data.category} 보러가기 →</a>
      </div>
    )}

    <p class="disclaimer">
      규격 출처: <a href={data.source.url} target="_blank" rel="noopener">{data.source.name}</a> (조회일 {data.source.asOfDate}). 모델 단종·사양 변경 시 최신 정보와 다를 수 있으니 구매 전 반드시 출처 링크에서 재확인하세요. {coupangUrl && '위 쿠팡 링크는 검색 결과로 연결되는 제휴 링크이며 특정 판매자·가격·이 모델의 실제 재고를 보증하지 않습니다. '}오류를 발견하셨다면 <a href="mailto:keiji960+mj06@gmail.com">keiji960+mj06@gmail.com</a>으로 알려주세요.
    </p>
  </article>
</Layout>
